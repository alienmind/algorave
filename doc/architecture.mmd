graph TD
    User((User))
    
    subgraph "Docker / Local Host"
        WebApp["fab:fa-react Web App (Algorave Hub)<br/>Port 3000"]
        
        subgraph "Integrations"
            Strudel["fas:fa-music Strudel REPL<br/>Port 4321 or public<br/>https://strudel.cc"]
        end
        
        subgraph "Backend"
            MCP["fas:fa-network-wired MCP Bridge<br/>Port 3001"]
            Headless["fas:fa-terminal Strudel REPL Headless Validation<br/>(Internal)"]
        end
    end

    subgraph "Cloud AI Services"
        OpenAI["<img src='OPENAI_LOGO_BASE64' width='30' /> OpenAI API"]
        Gemini["<img src='GEMINI_LOGO_BASE64' width='30' /> Google Gemini"]
    end
    
    %% User Interaction
    User -->|Visits| WebApp
    
    %% Web App orchestration
    WebApp -.->|Embeds| Strudel

    %% AI Connections
    WebApp <-->|HTTPS| OpenAI
    WebApp <-->|HTTPS| Gemini

    %% MCP Data Flow
    WebApp <-->|SSE Connection| MCP
    MCP -->|Validates Code| Headless
    
    %% Styling
    classDef hub fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px,color:#000;
    classDef integration fill:#e1d5e7,stroke:#9673a6,color:#000;
    classDef code fill:#d5e8d4,stroke:#82b366,color:#000;
    classDef mcp fill:#f8cecc,stroke:#b85450,color:#000;
    classDef cloud fill:#fff,stroke:#333,stroke-dasharray: 5 5,color:#333;

    class WebApp hub;
    class Strudel code;
    class MCP mcp;
    class OpenAI,Gemini cloud;
