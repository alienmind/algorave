// Borrowed from http://bit.ly/livecode-art-haus , originally available on https://strudel.cc/?HNLRK5hZCBab
typeof setDefaultVoicings !== 'undefined' && setDefaultVoicings('legacy') // https://github.com/tidalcycles/strudel/pull/967
// "Cowrave"
// @license CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/
// cowbell by Felix Boehme – otherwise mostly "Caverave" @by Felix Roos
setcps(1)

const keys = x => x.s('sawtooth').cutoff(1200).gain(.5)
.attack(0).decay(.16).sustain(.3).release(.1);

const drums = stack(
s("bd*2").mask("<x@7 ~>/8").gain(.8),
s("~ <sd!7 [sd@3 ~]>").mask("<x@7 ~>/4").gain(.5),
s("[~ hh]*2").delay(.3).delayfeedback(.5).delaytime(.125).gain(.4),
s("cowbell cowbell").struct("2(3,8)").gain(10)
);

const synths = stack(

"<eb4 d4 c4 b3>/2"
.scale("<C:minor!3 C:melodic:minor>/2")
.struct("[~ x]*2")
.layer(
x=>x.scaleTranspose(0).early(0),
x=>x.scaleTranspose(2).early(1/8),
x=>x.scaleTranspose(7).early(1/4),
x=>x.scaleTranspose(8).early(3/8)
).note().apply(keys).mask("<~ x>/16")
.color('darkseagreen'),

note("<C2 Bb1 Ab1 [G1 [G2 G1]]>/2")
.struct("[x [~ x] <[~ [~ x]]!3 [x x]>@2]/2".fast(2))
.s('cowbell cowbell').attack(0.001).decay(0.2).sustain(1).cutoff(500)
.color('red'),
chord("<Cm7 Bb7 Fm7 G7b13>/2")
.struct("~ [x@0.2 ~]".fast(2))
.dict('lefthand').voicing()
.every(2, early(1/8))
.apply(keys).sustain(0)
.delay(.4).delaytime(.12)
.mask("<x@7 ~>/8".early(1/4))
).add(note("<-1 0>/8"))
stack(
drums.fast(2).color('orange'),
synths
).slow(2)
//.pianoroll({fold:1})
