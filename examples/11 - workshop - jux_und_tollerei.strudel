// This demo plays around with palindromes, mild visualization effects (colors),
// and some basic sound processing (filters, panning, etc)

// Go an uncomment few lines below
// Feel free to change .pianoroll() with ._pianoroll()

setcps(1)

note("c3 eb3 g3 bb3").palindrome()
.s('sawtooth')
// .jux(x=>x.rev().color('green').s('sawtooth'))
// .off(1/4, x=>x.add(note("<7 12>/2")).slow(2).late(.005).s('triangle'))
// .lpf(sine.range(200,2000).slow(8))
.lpf(rand.range(500,2000))
.lpd("<.5 .25 .1 0>/4")
.lpa(.2).lpenv(-2)
.decay(.05).sustain(0)
.room(.6)
// .delay(.5).delaytime(.1).delayfeedback(.4)
.pianoroll()

// @version 1.0
