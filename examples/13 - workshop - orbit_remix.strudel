// "Orbit"
// @license CC BY-NC-SA 4.0 https://creativecommons.org/licenses/by-nc-sa/4.0/
// Gleb P remix of @by Felix Roos
// Borrowed from http://bit.ly/livecode-art-haus, originally available on https://strudel.cc/?rt0rtzTBHxOY
setcps(1)

stack(
    s("bd sd bd:16").bank("RolandTR808")
  .lpf(2000).delay(0.1).room("<0 0.4 0.2>")
  
  ,
  
n("<0 4 3*2>").color('salmon')
.off(1/4, x=>x.add(2).color('green'))
.off(1/2, x=>x.add(6).color('steelblue'))
.scale('F minor')
.echo(4, 1/8, .5)
.clip(.5).gain(0.7)
.sound('piano').gain(0.5).pianoroll()
  )

// @version 1.0
