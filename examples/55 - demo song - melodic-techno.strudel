// Set the global tempo a bit fast for the intense, running feel (around 135-150 BPM is typical)
// SetTempo(140)

// Tempo 120 bpm
setCps(120/60/4)

// Chord progression
const CHORD_PROGRESSION = "<Am!2 C!2 G Dm>"

// Perc
const KICKS_VOL=slider(0.49,0,1)
const SNARE_VOL=slider(0.49,0,1)
const HIHATS_VOL=slider(0.493,0,1)
const RHH_VOL=slider(0.59,0,1)

// Pads
const PADS_VOL=slider(0.363,0,1)

const ACID_VOL=slider(0,0,1)
const ACID_ENERGY=slider(5.952,0,8)

const BS_VOL=slider(0.442,0,1)
const ARP_VOL=slider(1,0,1)
const LEADS_VOL=slider(0,0,1)


const SUBPADS_VOL=slider(0.517,0,1)
const RISER_VOL=slider(0,0,1)

// Other modifiers

// 4 on the floor
$kick: s("bd*4")
  .bank("RolandTR909") // Use a heavy, punchy kick
  .dist("3:.3").gain(KICKS_VOL)._scope()
// Sidechain kick to orbit 2,3,4
.duck("2:3:4").duckattack(.2).duckdepth(.8)


// snare
snare: s("[~ sd]*2")
  .bank("RolandTR909") // Use a heavy, punchy kick
  .gain(SNARE_VOL)._scope()

$acid: n(irand(0).almostNever(x=>x.add(5)).sub(0).seg(16)).chord(CHORD_PROGRESSION).voicing()
  // Make it repeatable
  .rib(2,4)
  // Heavy distortion
  .dist("2:0.3")
  // Nice tb303 with adjustable energy
  .s("sawtooth").lpf(200).lpenv(ACID_ENERGY).lpq(12).gain(ACID_VOL)
  ._pianoroll()
  // Make it pump with the duck
  .orbit(2)



// Rolling hithats
$rollinghh: s("[hh]*16").gain(RHH_VOL)._scope()

// Upbeats only
$hihats: s("[~ hh]*4").delay(0.1).gain(HIHATS_VOL)._scope()

// Subpad to keep it interesting, detuned, every 2 bars
//$subpad: s("supersaw").chord(CHORD_PROGRESSION).voicing().detune(1).rel(5).beat(2,32).slow(2).orbit(2)
//.fm(slider(0,0,5)).fmh(slider(2.04,0,5)).room(1).roomsize(6).gain(SUBPADS_VOL)

$riser: s("pulse").orbit(4).seg(16).dec(.1).fm(time).fmh(time).gain(RISER_VOL)


$arp: n("0").chord(CHORD_PROGRESSION).voicing()
  .sound("supersaw")
  .lpf(slider(262,0,1000))
  .sustain(0.5).release(0.01).attack(0)
  .room(0.6)
  .lpenv(slider(4.00025,1.25,6))
  .postgain(ARP_VOL)
  .orbit(3)
  ._punchcard()



// Pads
$pads: s("supersaw").chord(CHORD_PROGRESSION).voicing().gain(PADS_VOL).orbit(3)._pianoroll()


// Bass
$bs: n("<0 <1 4 2 [2 1]>>*8").s("gm_acoustic_bass").chord(CHORD_PROGRESSION).voicing().gain(BS_VOL)._punchcard()
