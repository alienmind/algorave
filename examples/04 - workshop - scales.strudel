setcps(1)
/* MUSICAL SCALES! 
  note: make sure to use 'single quotes' for scale names 
  "double quotes" are for patterns and sounds 
  Borrowed from http://bit.ly/livecode-art-haus
  Originally available on https://strudel.cc/?lc6goKga1dmI  
*/
stack(
  "0 1 2 <3 4>".scale('c4 minor').note().sound("sine").slow(2),
  s("hh").struct("1 1 0 [1 1] 0 1 1 0").gain(0.4),
  n("0 2 4 6 4 0").scale("<G3 F3 D3>:<minor:pentatonic mixolydian>").jux(rev).mask("<0 1>/2"),
  s("sd:2").delay(.5).delaytime(1/3).gain(.2).mask("<0 1 0 1>/2")
)

// @version 1.0
